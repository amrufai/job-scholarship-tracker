# Rename this file to .env in the backend/ folder and fill in real values.
# Never commit your actual .env file.

JWT_SECRET=replace_with_a_long_random_string

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=job_scholarship_tracker
DB_SSL=false
DB_CONNECTION_LIMIT=10

PORT=5000

# Comma-separated list of extra origins allowed to call this API,
# in addition to http://localhost:3000 and the deployed frontend.
ALLOWED_ORIGINS=
